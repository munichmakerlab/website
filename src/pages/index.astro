---
import Posts from '../components/Posts.vue';
import Content from '../layouts/Content.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const frontmatter = {
  title: 'Munich Maker Lab',
  header_image: '/img/bg_front.jpg',
  headline: 'Munich Maker Lab',
  sub_headline: "Munich's freshest makerspace",
};
---

<Content frontmatter={frontmatter}>
  <p>
    The Munich Maker Lab is a makerspace close to the center of Munich, Germany. It provides tools, resources and space
    to any hacker, maker and tinkerer of any kind. <a href={getRelativeLocaleUrl(locale, 'about')}>Learn more...</a>
  </p>
  <hr />
  Follow us on social media to stay up to date with the latest news and activities at the space:
  <SocialLinks locale={locale} />
  <hr />

  <h2>Latest activities at the Space:</h2>
  <Posts client:only="vue" locale={Astro.currentLocale ?? 'en'} />
</Content>
