---
import { getUiTranslations } from '../i18n/ui/ui-i18n-helper';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SocialMediaLinks from './SocialMediaLinks.astro';
import FormerSocialMediaLinks from './FormerSocialMediaLinks.astro';

const locale = Astro.currentLocale ?? 'en';
const t = getUiTranslations(locale);
---

<footer>
  <SocialMediaLinks />
  <FormerSocialMediaLinks />

  <div class="text">
    Munich Maker Lab e.V.
    <br />
    <a href={getRelativeLocaleUrl(locale, 'imprint')}>{t.footer.imprint}</a> - <a
      href={getRelativeLocaleUrl(locale, 'privacy')}>{t.footer.privacyPolicy}</a
    >
    <br />
    {t.footer.editOnGithub}
    <a href="https://github.com/munichmakerlab/website">Github</a>
  </div>
</footer>

<style>
  footer {
    width: 100vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3rem 0 5rem 0;
    margin-top: 5rem;
    border-top: 1px solid #eee;
  }

  .text {
    text-align: center;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .text a {
    color: var(--fg);
  }
</style>
