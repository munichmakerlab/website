---
import { Icon } from 'astro-icon/components';

const { showLabels = false } = Astro.props;
---

<div class="links">
  <a rel="me" href="https://chaos.social/@munichmakerlab">
    <Icon name="mdi:mastodon" />
    {showLabels && <span>Mastodon</span>}
  </a>
  <a href="https://www.instagram.com/munichmakerlab">
    <Icon name="mdi:instagram" />
    {showLabels && <span>Instagram</span>}
  </a>
  <a
    href="https://bsky.app/profile/munichmakerlab.bsky.social"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Bluesky"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      x="0px"
      y="0px"
      width="33"
      height="33"
      viewBox="0 0 24 24"
      style="fill: var(--fg);"
    >
      <path
        d="M5.769,3.618C8.291,5.512,11.004,9.352,12,11.412c0.996-2.06,3.709-5.9,6.231-7.793C20.051,2.252,23,1.195,23,4.559c0,0.672-0.385,5.644-0.611,6.451c-0.785,2.806-3.647,3.522-6.192,3.089c4.449,0.757,5.581,3.265,3.137,5.774c-4.643,4.764-6.672-1.195-7.193-2.722c-0.095-0.28-0.14-0.411-0.14-0.3c-0.001-0.112-0.045,0.019-0.14,0.3c-0.521,1.527-2.55,7.486-7.193,2.722c-2.445-2.509-1.313-5.017,3.137-5.774c-2.546,0.433-5.407-0.282-6.192-3.089C1.385,10.203,1,5.231,1,4.559C1,1.195,3.949,2.252,5.769,3.618L5.769,3.618z"
      ></path>
    </svg>
    {showLabels && <span>Bluesky</span>}
  </a>
  <a href="https://www.meetup.com/munichmakerlab/" target="_blank" rel="noopener noreferrer" aria-label="Meetup">
    <Icon name="mdi:meetup" />
    {showLabels && <span>Meetup</span>}
  </a>
  <a href="https://www.facebook.com/munichmakerlab">
    <Icon name="mdi:facebook" />
    {showLabels && <span>Facebook</span>}
  </a>
  <a href="https://github.com/munichmakerlab">
    <Icon name="mdi:github" />
    {showLabels && <span>GitHub</span>}
  </a>
  <a href="https://www.youtube.com/channel/UCTZVQ5naAWNuawd1DLnmlQA">
    <Icon name="mdi:youtube" />
    {showLabels && <span>YouTube</span>}
  </a>
</div>

<style>
  .links > a {
    text-decoration: none;
    color: var(--fg);
    font-size: 2rem;
  }
</style>
