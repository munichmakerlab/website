---
import { Icon } from 'astro-icon/components';

const { locale = 'en' } = Astro.props;

const heading = locale === 'de' ? 'Folge uns' : 'Follow Us';
---

<div class="social-links">
  <h2>{heading}</h2>
  <div class="links">
    <a rel="me" href="https://chaos.social/@munichmakerlab" target="_blank" rel="noopener noreferrer" aria-label="Mastodon">
      <Icon name="mdi:mastodon" />
      <span>Mastodon</span>
    </a>
    <a href="https://bsky.app/profile/munichmakerlab.bsky.social" target="_blank" rel="noopener noreferrer" aria-label="Bluesky">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" style="fill: currentColor;" aria-hidden="true">
        <path d="M5.769,3.618C8.291,5.512,11.004,9.352,12,11.412c0.996-2.06,3.709-5.9,6.231-7.793C20.051,2.252,23,1.195,23,4.559c0,0.672-0.385,5.644-0.611,6.451c-0.785,2.806-3.647,3.522-6.192,3.089c4.449,0.757,5.581,3.265,3.137,5.774c-4.643,4.764-6.672-1.195-7.193-2.722c-0.095-0.28-0.14-0.411-0.14-0.3c-0.001-0.112-0.045,0.019-0.14,0.3c-0.521,1.527-2.55,7.486-7.193,2.722c-2.445-2.509-1.313-5.017,3.137-5.774c-2.546,0.433-5.407-0.282-6.192-3.089C1.385,10.203,1,5.231,1,4.559C1,1.195,3.949,2.252,5.769,3.618L5.769,3.618z"/>
      </svg>
      <span>Bluesky</span>
    </a>
    <a href="https://www.instagram.com/munichmakerlab" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <Icon name="mdi:instagram" />
      <span>Instagram</span>
    </a>
    <a href="https://www.facebook.com/munichmakerlab" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
      <Icon name="mdi:facebook" />
      <span>Facebook</span>
    </a>
    <a href="https://github.com/munichmakerlab" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <Icon name="mdi:github" />
      <span>GitHub</span>
    </a>
    <a href="https://www.meetup.com/munichmakerlab/" target="_blank" rel="noopener noreferrer" aria-label="Meetup">
      <Icon name="mdi:meetup" />
      <span>Meetup</span>
    </a>
    <a href="https://www.youtube.com/channel/UCTZVQ5naAWNuawd1DLnmlQA" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
      <Icon name="mdi:youtube" />
      <span>YouTube</span>
    </a>
  </div>
  <p class="former-channels">
    <span>{formerChannels}</span>
    <a href="https://twitter.com/munichmakerlab" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X">
      <Icon name="mdi:twitter" />
    </a>
    <a href="http://log.munichmakerlab.de" target="_blank" rel="noopener noreferrer" aria-label="Tumblr">
      <Icon name="mdi:tumblr" />
    </a>
  </p>
</div>

<style>
  .social-links {
    margin-top: 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--fg);
    font-size: 1rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--muted, #ccc);
    border-radius: 0.4rem;
    transition: opacity 0.2s;
  }

  .links a:hover {
    opacity: 0.7;
  }

  .links a :global(svg),
  .links a svg {
    font-size: 1.4rem;
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }

  .former-channels {
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .former-channels a {
    color: var(--muted);
    text-decoration: none;
    font-size: 1.2rem;
    transition: opacity 0.2s;
  }

  .former-channels a:hover {
    opacity: 0.7;
  }

  .former-channels a :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
